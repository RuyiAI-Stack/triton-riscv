{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "timezone": "Asia/Shanghai",
  "schedule": ["* 2 * * *"],
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/build\\.sh$/"],
      "matchStrings": [
        "BUDDY_RELEASE_TAG=\\\"(?<currentValue>[^\\\"\\n]+)\\\""
      ],
      "depNameTemplate": "buddy-compiler/buddy-mlir",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?:release/v|nightly/v)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.dev(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^buddy-hash\\.txt$/"],
      "matchStrings": [
        "(?<currentDigest>[0-9a-f]{40})"
      ],
      "currentValueTemplate": "release/v0.0.5",
      "autoReplaceStringTemplate": "{{{newDigest}}}",
      "depNameTemplate": "buddy-compiler/buddy-mlir",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?:release/v|nightly/v)(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.dev(?<build>\\d+))?$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["buddy-compiler/buddy-mlir"],
      "allowedVersions": "/^(?:release\\/v|nightly\\/v)\\d+\\.\\d+\\.\\d+(?:\\.dev\\d+)?$/",
      "ignoreUnstable": false,
      "maxMajorIncrement": 0,
      "groupName": "Buddy MLIR release",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "ignoreTests": false,
      "prCreation": "immediate"
    }
  ]
}
