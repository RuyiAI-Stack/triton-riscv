@@ -1227,6 +1227,38 @@ def FuncOp : TT_Op<"func", [
     //===------------------------------------------------------------------===//
 
     bool isDeclaration() { return isExternal(); }
+
+    /// Returns the name attribute of this symbol.
+    ///
+    /// Newer MLIR revisions stopped providing these accessors from the
+    /// SymbolOpInterface trait (the op must define them instead), so spell them
+    /// out here to stay compatible with both the old and new symbol API.
+    ::mlir::StringAttr getNameAttr() { return getSymNameAttr(); }
+
+    /// Returns the name of this symbol.
+    ::mlir::StringRef getName() { return getSymName(); }
+
+    /// Returns the visibility of this symbol.
+    ::mlir::SymbolTable::Visibility getVisibility() {
+      auto visibility = getSymVisibilityAttr();
+      if (!visibility || visibility.getValue() == "public")
+        return ::mlir::SymbolTable::Visibility::Public;
+      if (visibility.getValue() == "private")
+        return ::mlir::SymbolTable::Visibility::Private;
+      return ::mlir::SymbolTable::Visibility::Nested;
+    }
+
+    /// Sets the visibility of this symbol.
+    void setVisibility(::mlir::SymbolTable::Visibility visibility) {
+      if (visibility == ::mlir::SymbolTable::Visibility::Public) {
+        setSymVisibilityAttr(nullptr);
+        return;
+      }
+      ::llvm::StringRef value =
+          visibility == ::mlir::SymbolTable::Visibility::Private ? "private"
+                                                                  : "nested";
+      setSymVisibilityAttr(::mlir::StringAttr::get(getContext(), value));
+    }
   }];
   let hasCustomAssemblyFormat = 1;
 }
