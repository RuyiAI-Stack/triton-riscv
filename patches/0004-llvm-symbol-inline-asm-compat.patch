+// The `convergent` attribute was added to `llvm.inline_asm`, which changed the
+// generated builder signature. Detect the available builder so the same call
+// site compiles against both the old and the new LLVM dialect.
+template <typename T, typename = void>
+struct InlineAsmBuilderHasConvergent : std::false_type {};
+
+template <typename T>
+struct InlineAsmBuilderHasConvergent<
+    T, std::void_t<decltype(T::create(
+           std::declval<OpBuilder &>(), std::declval<Location>(),
+           std::declval<Type>(), std::declval<ValueRange>(),
+           std::declval<StringRef>(), std::declval<StringRef>(),
+           std::declval<bool>(), std::declval<bool>(),
+           std::declval<LLVM::TailCallKind>(), std::declval<bool>(),
+           std::declval<LLVM::AsmDialectAttr>(),
+           std::declval<ArrayAttr>()))>> : std::true_type {};
+
+template <typename OpTy = LLVM::InlineAsmOp>
+OpTy createInlineAsmOp(OpBuilder &builder, Location loc, Type resType,
+                       ValueRange operands, StringRef asmString,
+                       StringRef constraints, bool hasSideEffects,
+                       bool isAlignStack, LLVM::TailCallKind tailCallKind,
+                       LLVM::AsmDialectAttr asmDialect,
+                       ArrayAttr operandAttrs) {
+  if constexpr (InlineAsmBuilderHasConvergent<OpTy>::value) {
+    return OpTy::create(builder, loc, resType, operands, asmString, constraints,
+                        hasSideEffects, isAlignStack, tailCallKind,
+                        /*convergent=*/false, asmDialect, operandAttrs);
+  } else {
+    return OpTy::create(builder, loc, resType, operands, asmString, constraints,
+                        hasSideEffects, isAlignStack, tailCallKind, asmDialect,
+                        operandAttrs);
+  }
+}
+
+} // namespace
