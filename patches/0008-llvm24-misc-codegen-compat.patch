diff --git a/CMakeLists.txt b/CMakeLists.txt
index 44496c59e8..08075a9601 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -400,6 +400,14 @@ if(TRITON_BUILD_PYTHON_MODULE)
     list(APPEND TRITON_LIBRARIES LLVMAMDGPUCodeGen LLVMAMDGPUAsmParser)
     add_compile_definitions(TRITON_ENABLE_AMDGPU_TARGET)
   endif()
+  # init_targets initializes every target the LLVM build provides, so link all
+  # of them (e.g. RISCV components on an x86_64 host using a cross-capable
+  # toolchain LLVM). NVPTX/AMDGPU are handled above.
+  foreach(LLVM_TARGET ${LLVM_TARGETS_TO_BUILD})
+    if(NOT "${LLVM_TARGET}" STREQUAL "NVPTX" AND NOT "${LLVM_TARGET}" STREQUAL "AMDGPU")
+      list(APPEND TRITON_LIBRARIES LLVM${LLVM_TARGET}CodeGen LLVM${LLVM_TARGET}AsmParser)
+    endif()
+  endforeach()
 
   if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64" OR # Linux arm64
      CMAKE_SYSTEM_PROCESSOR MATCHES "arm64" OR # macOS arm64
